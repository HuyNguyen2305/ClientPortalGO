DATABASE_URL=postgres://postgres:postgres@localhost:5432/clientportal?sslmode=disable
TEST_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
# At least 32 characters; generate one with: openssl rand -hex 32
ADMIN_API_KEY=replace-with-a-random-key-of-32-or-more-characters
# "production" refuses to start without MAIL_API_KEY, so reset links never end up in the logs.
APP_ENV=development
# Reverse proxy IPs or CIDRs (comma-separated) whose X-Forwarded-For is believed. Empty trusts none.
TRUSTED_PROXIES=
PORT=8080
DB_MAX_CONNS=10
QUERY_TIMEOUT=5s
SESSION_TTL=720h
BUSINESS_TZ=America/Chicago
BOOKING_OPEN=07:00
BOOKING_CLOSE=17:00
BOOKING_STEP_MINUTES=15
BOOKING_HORIZON_DAYS=90
BOOKING_MAX_LIVE=3
MAIL_API_KEY=
MAIL_FROM=
RESET_URL_BASE=http://localhost:3000/reset-password
